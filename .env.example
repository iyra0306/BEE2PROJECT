# GEMINI_API_KEY: Required for Gemini AI API calls if Gemini features are added.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional Server-Side Market Data & Service Environment Variables
# All market data providers are optional at startup; the app starts without them.
# Configure these only when connecting real feeds in server Secrets:
# - Indian equities & indices (Global Datafeeds): GFDL_API_KEY, GFDL_REST_URL, and
#   (only if GFDL_STREAMING_ENABLED is true) GFDL_WS_URL; optional GFDL_ALLOWED_EXCHANGES,
#   GFDL_NIFTY_EXCHANGE, GFDL_NIFTY_SYMBOL, GFDL_SENSEX_EXCHANGE, GFDL_SENSEX_SYMBOL,
#   GFDL_FEED_FRESHNESS, GFDL_FUNDAMENTALS_ENABLED.
# - US equities, IXIC, SPX & FX (Twelve Data): TWELVE_DATA_API_KEY,
#   optional TWELVE_DATA_FEED_FRESHNESS, TWELVE_DATA_RATE_LIMIT_RPM.
# - News & Forecasts (Optional): NEWS_API_URL, NEWS_API_KEY,
#   PYTHON_PREDICTION_URL, PYTHON_PREDICTION_API_KEY.
# - User Accounts & Saved Watchlists (Optional, required only for Sign-In / Registration):
#   MONGODB_URI, JWT_SECRET.

